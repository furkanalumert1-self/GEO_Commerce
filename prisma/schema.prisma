// GEO Commerce — veri modeli (§10). id=uuid, ts=timestamptz, para=BigInt minor units.
// Tenant tablolarında workspaceId NOT NULL; brand-scoped tablolarda brandId NOT NULL ve
// (workspaceId, brandId) → Brand(workspaceId, id) composite FK ile tenant uyumu DB düzeyinde korunur.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────────── Enums ─────────────────────────────

enum Role {
  owner
  admin
  editor
  analyst
  viewer
  client
  billing
}

enum PlanKey {
  free_audit
  starter
  growth
  commerce
  agency
  enterprise
}

enum SubscriptionStatus {
  trialing
  active
  past_due
  canceled
  incomplete
  read_only
}

enum JobStatus {
  queued
  running
  partial
  succeeded
  failed
  canceled
  dead
}

enum Surface {
  api_grounded
  api_plain
  licensed_ui
}

enum ObservationStatus {
  pending
  succeeded
  failed
  parse_failed
}

enum IntentType {
  informational
  category_discovery
  transactional
  comparison
  alternative
  local
}

enum MentionKind {
  mention
  recommendation
  negative
  incidental
}

enum CitationAssociation {
  own
  competitor
  third_party
}

enum OpportunityStatus {
  new
  triaged
  in_progress
  measuring
  won
  dismissed
}

enum GapType {
  intent_content
  missing_comparison
  catalog_mismatch
  technical_access
  citation_gap
  structured_data
}

enum ActionType {
  content
  landing
  category
  product
  comparison
  faq
  schema
  citation_task
  ad_draft
}

enum ActionStatus {
  draft
  review
  approved
  publishing
  published
  measuring
  completed
  failed
  rejected
  rolled_back
}

enum IntegrationStatus {
  not_configured
  connecting
  syncing
  healthy
  degraded
  reauth_required
  unsupported
}

enum ReservationState {
  reserved
  committed
  released
}

// ───────────────────────────── Auth.js ─────────────────────────────

model User {
  id            String    @id @default(uuid()) @db.Uuid
  name          String?
  email         String    @unique
  emailVerified DateTime? @db.Timestamptz
  image         String?
  locale        String    @default("tr")
  createdAt     DateTime  @default(now()) @db.Timestamptz
  updatedAt     DateTime  @updatedAt @db.Timestamptz

  accounts      Account[]
  sessions      Session[]
  memberships   Membership[]
  notifications Notification[]
}

model Account {
  userId            String  @db.Uuid
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String   @db.Uuid
  expires      DateTime @db.Timestamptz
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime @db.Timestamptz

  @@id([identifier, token])
}

// ───────────────────────────── Tenancy ─────────────────────────────

model Workspace {
  id              String   @id @default(uuid()) @db.Uuid
  name            String
  slug            String   @unique
  ownerId         String   @db.Uuid
  timezone        String   @default("Europe/Istanbul")
  status          String   @default("active") // active | suspended | deleting
  billingCurrency String   @default("USD")
  isDemo          Boolean  @default(false)
  createdAt       DateTime @default(now()) @db.Timestamptz
  updatedAt       DateTime @updatedAt @db.Timestamptz

  memberships  Membership[]
  brands       Brand[]
  invites      Invite[]
  subscription Subscription?
  whiteLabel   WhiteLabel?
  usageBuckets UsageBucket[]
  apiKeys      ApiKey[]
  auditLogs    AuditLog[]
}

model Membership {
  id          String   @id @default(uuid()) @db.Uuid
  workspaceId String   @db.Uuid
  userId      String   @db.Uuid
  role        Role
  isApprover  Boolean  @default(false) // Editor için ayrı publish/budget onayı
  createdAt   DateTime @default(now()) @db.Timestamptz
  updatedAt   DateTime @updatedAt @db.Timestamptz

  workspace Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  grants    BrandGrant[]

  @@unique([workspaceId, userId])
  @@unique([workspaceId, id])
}

model BrandGrant {
  id           String   @id @default(uuid()) @db.Uuid
  workspaceId  String   @db.Uuid
  membershipId String   @db.Uuid
  brandId      String   @db.Uuid
  role         Role
  createdAt    DateTime @default(now()) @db.Timestamptz
  updatedAt    DateTime @updatedAt @db.Timestamptz

  membership Membership @relation(fields: [workspaceId, membershipId], references: [workspaceId, id], onDelete: Cascade)
  brand      Brand      @relation(fields: [workspaceId, brandId], references: [workspaceId, id], onDelete: Cascade)

  @@unique([membershipId, brandId])
}

model Invite {
  id          String    @id @default(uuid()) @db.Uuid
  workspaceId String    @db.Uuid
  email       String
  role        Role
  brandIds    String[]  @db.Uuid
  tokenHash   String    @unique
  expiresAt   DateTime  @db.Timestamptz
  acceptedAt  DateTime? @db.Timestamptz
  createdAt   DateTime  @default(now()) @db.Timestamptz
  updatedAt   DateTime  @updatedAt @db.Timestamptz

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model Brand {
  id         String    @id @default(uuid()) @db.Uuid
  workspaceId String   @db.Uuid
  domain     String
  name       String
  aliases    String[]
  country    String    @default("TR")
  language   String    @default("tr")
  timezone   String    @default("Europe/Istanbul")
  currency   String    @default("TRY")
  categories String[]
  verifiedAt DateTime? @db.Timestamptz
  archivedAt DateTime? @db.Timestamptz
  readOnly   Boolean   @default(false) // downgrade sonrası seçilmeyen markalar
  onboarding Json?
  trackerSiteKey String @unique @default(uuid())
  createdAt  DateTime  @default(now()) @db.Timestamptz
  updatedAt  DateTime  @updatedAt @db.Timestamptz

  workspace          Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  grants             BrandGrant[]
  verifications      DomainVerification[]
  crawlRuns          CrawlRun[]
  categoriesRel      Category[]
  products           Product[]
  clusters           IntentCluster[]
  prompts            Prompt[]
  competitors        Competitor[]
  schedules          MonitoringSchedule[]
  runs               MonitoringRun[]
  metricSnapshots    MetricSnapshot[]
  opportunities      Opportunity[]
  actions            Action[]
  integrations       Integration[]
  orders             Order[]
  events             Event[]
  visitorSessions    VisitorSession[]
  adsAccounts        AdsAccount[]
  adsRules           AdsRule[]
  reports            Report[]

  @@unique([workspaceId, domain])
  @@unique([workspaceId, id])
  @@index([workspaceId, createdAt(sort: Desc)])
}

model DomainVerification {
  id          String    @id @default(uuid()) @db.Uuid
  workspaceId String    @db.Uuid
  brandId     String    @db.Uuid
  method      String // dns_txt | html_token | oauth
  tokenHash   String
  expiresAt   DateTime  @db.Timestamptz
  verifiedAt  DateTime? @db.Timestamptz
  createdAt   DateTime  @default(now()) @db.Timestamptz
  updatedAt   DateTime  @updatedAt @db.Timestamptz

  brand Brand @relation(fields: [workspaceId, brandId], references: [workspaceId, id], onDelete: Cascade)
}

model WhiteLabel {
  id           String    @id @default(uuid()) @db.Uuid
  workspaceId  String    @unique @db.Uuid
  logoKey      String?
  displayName  String?
  accent       String?
  customDomain String?   @unique
  verifiedAt   DateTime? @db.Timestamptz
  createdAt    DateTime  @default(now()) @db.Timestamptz
  updatedAt    DateTime  @updatedAt @db.Timestamptz

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

// ───────────────────────────── Billing & usage ─────────────────────────────

model Plan {
  id           String   @id @default(uuid()) @db.Uuid
  planKey      PlanKey
  version      Int
  monthlyPrice Int? // USD cent; enterprise null
  createdAt    DateTime @default(now()) @db.Timestamptz
  updatedAt    DateTime @updatedAt @db.Timestamptz

  entitlement PlanEntitlement?

  @@unique([planKey, version])
}

model PlanEntitlement {
  id        String   @id @default(uuid()) @db.Uuid
  planId    String   @unique @db.Uuid
  limits    Json
  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  plan Plan @relation(fields: [planId], references: [id], onDelete: Cascade)
}

model Subscription {
  id                 String             @id @default(uuid()) @db.Uuid
  workspaceId        String             @unique @db.Uuid
  planKey            PlanKey
  planVersion        Int                @default(1)
  status             SubscriptionStatus
  billingCustomerId  String?
  subscriptionId     String?            @unique
  currentPeriodStart DateTime           @db.Timestamptz
  currentPeriodEnd   DateTime           @db.Timestamptz
  trialEnd           DateTime?          @db.Timestamptz
  pastDueSince       DateTime?          @db.Timestamptz
  cancelAtPeriodEnd  Boolean            @default(false)
  pendingPlanKey     PlanKey?
  overrideLimits     Json? // Enterprise sözleşme override
  overrideExpiresAt  DateTime?          @db.Timestamptz
  overrideReason     String?
  lastProviderEventAt DateTime?         @db.Timestamptz
  createdAt          DateTime           @default(now()) @db.Timestamptz
  updatedAt          DateTime           @updatedAt @db.Timestamptz

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model UsageBucket {
  id          String   @id @default(uuid()) @db.Uuid
  workspaceId String   @db.Uuid
  metric      String
  period      String // subscription cycle anahtarı (UTC başlangıç ISO)
  limit       Int
  used        Int      @default(0)
  reserved    Int      @default(0)
  notified80  Boolean  @default(false)
  notified100 Boolean  @default(false)
  createdAt   DateTime @default(now()) @db.Timestamptz
  updatedAt   DateTime @updatedAt @db.Timestamptz

  workspace    Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  reservations UsageReservation[]

  @@unique([workspaceId, metric, period])
}

model UsageReservation {
  id          String           @id @default(uuid()) @db.Uuid
  workspaceId String           @db.Uuid
  bucketId    String           @db.Uuid
  operationId String           @unique
  amount      Int
  committed   Int              @default(0)
  state       ReservationState @default(reserved)
  expiresAt   DateTime         @db.Timestamptz
  createdAt   DateTime         @default(now()) @db.Timestamptz
  updatedAt   DateTime         @updatedAt @db.Timestamptz

  bucket UsageBucket @relation(fields: [bucketId], references: [id], onDelete: Cascade)

  @@index([state, expiresAt])
}

model CostLedger {
  id          String   @id @default(uuid()) @db.Uuid
  workspaceId String?  @db.Uuid // audit pre-claim null olabilir
  provider    String
  model       String?
  operation   String
  attemptId   String
  costMicros  BigInt // USD micro
  currency    String   @default("USD")
  succeeded   Boolean
  createdAt   DateTime @default(now()) @db.Timestamptz
  updatedAt   DateTime @updatedAt @db.Timestamptz

  @@unique([attemptId])
  @@index([createdAt])
  @@index([workspaceId, createdAt])
}

// ───────────────────────────── Audit (public lead magnet) ─────────────────────────────

model Audit {
  id               String    @id @default(uuid()) @db.Uuid
  workspaceId      String?   @db.Uuid // yalnız claim sonrası
  domain           String
  locale           String    @default("tr-TR")
  tokenHash        String    @unique
  claimTokenHash   String?   @unique
  claimUserId      String?   @db.Uuid
  claimedAt        DateTime? @db.Timestamptz
  fingerprintHash  String
  status           JobStatus @default(queued)
  stage            String    @default("queued")
  progressDone     Int       @default(0)
  progressTotal    Int       @default(0)
  resultSummary    Json?
  errorCode        String?
  expiresAt        DateTime  @db.Timestamptz
  createdAt        DateTime  @default(now()) @db.Timestamptz
  updatedAt        DateTime  @updatedAt @db.Timestamptz

  @@index([domain, createdAt])
  @@index([fingerprintHash, createdAt])
}

// ───────────────────────────── Crawl & catalog ─────────────────────────────

model CrawlRun {
  id          String    @id @default(uuid()) @db.Uuid
  workspaceId String    @db.Uuid
  brandId     String    @db.Uuid
  status      JobStatus @default(queued)
  maxPages    Int
  pagesFound  Int       @default(0)
  pagesDone   Int       @default(0)
  pagesFailed Int       @default(0)
  startedAt   DateTime? @db.Timestamptz
  finishedAt  DateTime? @db.Timestamptz
  createdAt   DateTime  @default(now()) @db.Timestamptz
  updatedAt   DateTime  @updatedAt @db.Timestamptz

  brand     Brand          @relation(fields: [workspaceId, brandId], references: [workspaceId, id], onDelete: Cascade)
  snapshots PageSnapshot[]
}

model PageSnapshot {
  id             String   @id @default(uuid()) @db.Uuid
  workspaceId    String   @db.Uuid
  brandId        String   @db.Uuid
  crawlRunId     String   @db.Uuid
  url            String
  canonical      String?
  pageType       String? // product | category | policy | contact | home | other
  httpStatus     Int?
  contentHash    String?
  etag           String?
  title          String?
  textStorageKey String?
  schemaTypes    String[]
  findings       Json?
  excluded       Boolean  @default(false)
  sampledAt      DateTime @db.Timestamptz
  createdAt      DateTime @default(now()) @db.Timestamptz
  updatedAt      DateTime @updatedAt @db.Timestamptz

  crawlRun CrawlRun @relation(fields: [crawlRunId], references: [id], onDelete: Cascade)

  @@unique([crawlRunId, url])
  @@index([workspaceId, brandId, canonical])
  @@index([contentHash])
}

model Category {
  id          String   @id @default(uuid()) @db.Uuid
  workspaceId String   @db.Uuid
  brandId     String   @db.Uuid
  connectorId String?  @db.Uuid
  externalId  String
  name        String
  url         String?
  createdAt   DateTime @default(now()) @db.Timestamptz
  updatedAt   DateTime @updatedAt @db.Timestamptz

  brand    Brand             @relation(fields: [workspaceId, brandId], references: [workspaceId, id], onDelete: Cascade)
  products ProductCategory[]

  @@unique([brandId, connectorId, externalId])
}

model Product {
  id          String   @id @default(uuid()) @db.Uuid
  workspaceId String   @db.Uuid
  brandId     String   @db.Uuid
  connectorId String?  @db.Uuid
  externalId  String
  name        String
  description String?
  url         String?
  imageUrl    String?
  attributes  Json?
  active      Boolean  @default(true)
  source      String   @default("crawl") // crawl | feed | csv | connector
  createdAt   DateTime @default(now()) @db.Timestamptz
  updatedAt   DateTime @updatedAt @db.Timestamptz

  brand      Brand             @relation(fields: [workspaceId, brandId], references: [workspaceId, id], onDelete: Cascade)
  variants   ProductVariant[]
  categories ProductCategory[]

  @@unique([brandId, connectorId, externalId])
  @@index([workspaceId, brandId, createdAt(sort: Desc)])
}

model ProductVariant {
  id          String   @id @default(uuid()) @db.Uuid
  workspaceId String   @db.Uuid
  productId   String   @db.Uuid
  externalId  String
  sku         String?
  priceMinor  BigInt?
  currency    String?
  stock       Int?
  available   Boolean?
  createdAt   DateTime @default(now()) @db.Timestamptz
  updatedAt   DateTime @updatedAt @db.Timestamptz

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, externalId])
}

model ProductCategory {
  productId  String @db.Uuid
  categoryId String @db.Uuid

  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([productId, categoryId])
}

// ───────────────────────────── Prompts & monitoring ─────────────────────────────

model IntentCluster {
  id          String     @id @default(uuid()) @db.Uuid
  workspaceId String     @db.Uuid
  brandId     String     @db.Uuid
  category    String?
  type        IntentType
  label       String
  locale      String
  createdAt   DateTime   @default(now()) @db.Timestamptz
  updatedAt   DateTime   @updatedAt @db.Timestamptz

  brand         Brand         @relation(fields: [workspaceId, brandId], references: [workspaceId, id], onDelete: Cascade)
  prompts       Prompt[]
  opportunities Opportunity[]

  @@unique([brandId, label, locale])
}

model Prompt {
  id          String    @id @default(uuid()) @db.Uuid
  workspaceId String    @db.Uuid
  brandId     String    @db.Uuid
  clusterId   String    @db.Uuid
  active      Boolean   @default(true)
  branded     Boolean   @default(false)
  weight      Float     @default(1)
  targetPage  String?
  source      String    @default("user") // user | generated | audit
  archivedAt  DateTime? @db.Timestamptz
  currentVersionId String? @db.Uuid
  createdAt   DateTime  @default(now()) @db.Timestamptz
  updatedAt   DateTime  @updatedAt @db.Timestamptz

  brand    Brand           @relation(fields: [workspaceId, brandId], references: [workspaceId, id], onDelete: Cascade)
  cluster  IntentCluster   @relation(fields: [clusterId], references: [id], onDelete: Cascade)
  versions PromptVersion[]

  @@index([workspaceId, brandId, active])
}

model PromptVersion {
  id               String   @id @default(uuid()) @db.Uuid
  workspaceId      String   @db.Uuid
  promptId         String   @db.Uuid
  version          Int
  text             String
  normalizedHash   String
  commercialScore  Int
  commercialRubric Json
  rationale        String?
  scoreOverridden  Boolean  @default(false)
  createdAt        DateTime @default(now()) @db.Timestamptz
  updatedAt        DateTime @updatedAt @db.Timestamptz

  prompt       Prompt        @relation(fields: [promptId], references: [id], onDelete: Cascade)
  observations Observation[]

  @@unique([promptId, version])
  @@index([workspaceId, normalizedHash])
}

model Competitor {
  id          String    @id @default(uuid()) @db.Uuid
  workspaceId String    @db.Uuid
  brandId     String    @db.Uuid
  name        String
  domain      String
  aliases     String[]
  source      String    @default("user") // user | ai_candidate | domain_finding
  confirmedAt DateTime? @db.Timestamptz
  archivedAt  DateTime? @db.Timestamptz
  createdAt   DateTime  @default(now()) @db.Timestamptz
  updatedAt   DateTime  @updatedAt @db.Timestamptz

  brand Brand @relation(fields: [workspaceId, brandId], references: [workspaceId, id], onDelete: Cascade)

  @@unique([brandId, domain])
}

model MonitoringSchedule {
  id          String   @id @default(uuid()) @db.Uuid
  workspaceId String   @db.Uuid
  brandId     String   @db.Uuid
  engines     String[]
  locales     String[]
  frequency   String // weekly | daily
  repetitions Int      @default(1)
  budgetUnits Int
  cohortCursor Int     @default(0)
  enabled     Boolean  @default(true)
  nextRunAt   DateTime? @db.Timestamptz
  createdAt   DateTime @default(now()) @db.Timestamptz
  updatedAt   DateTime @updatedAt @db.Timestamptz

  brand Brand @relation(fields: [workspaceId, brandId], references: [workspaceId, id], onDelete: Cascade)

  @@unique([brandId])
}

model MonitoringRun {
  id                String    @id @default(uuid()) @db.Uuid
  workspaceId       String    @db.Uuid
  brandId           String    @db.Uuid
  status            JobStatus @default(queued)
  trigger           String // manual | schedule | audit | demo
  configVersion     String
  engines           String[]
  locales           String[]
  repetitions       Int
  scheduledCount    Int
  completedCount    Int       @default(0)
  failedCount       Int       @default(0)
  coverage          Float?
  operationId       String    @unique
  scheduledAt       DateTime  @db.Timestamptz
  startedAt         DateTime? @db.Timestamptz
  finishedAt        DateTime? @db.Timestamptz
  createdAt         DateTime  @default(now()) @db.Timestamptz
  updatedAt         DateTime  @updatedAt @db.Timestamptz

  brand        Brand         @relation(fields: [workspaceId, brandId], references: [workspaceId, id], onDelete: Cascade)
  observations Observation[]

  @@index([workspaceId, brandId, createdAt(sort: Desc)])
}

model Observation {
  id              String            @id @default(uuid()) @db.Uuid
  workspaceId     String            @db.Uuid
  brandId         String            @db.Uuid
  runId           String            @db.Uuid
  promptVersionId String            @db.Uuid
  provider        String
  engine          String // chatgpt | gemini | perplexity | google_ai_overviews | copilot
  model           String?
  surface         Surface
  country         String
  language        String
  repetition      Int
  attempt         Int               @default(1)
  status          ObservationStatus @default(pending)
  errorCode       String?
  rawStorageKey   String?
  rawText         String? // TTL 30 gün; retention job temizler
  listDetected    Boolean           @default(false)
  latencyMs       Int?
  costMicros      BigInt?
  parseVersion    String?
  weight          Float             @default(1)
  sampleKey       String            @unique // run+promptVersion+engine+locale+repetition
  sampledAt       DateTime          @db.Timestamptz
  createdAt       DateTime          @default(now()) @db.Timestamptz
  updatedAt       DateTime          @updatedAt @db.Timestamptz

  run           MonitoringRun         @relation(fields: [runId], references: [id], onDelete: Cascade)
  promptVersion PromptVersion         @relation(fields: [promptVersionId], references: [id], onDelete: Cascade)
  mentions      Mention[]
  citations     Citation[]
  evidence      OpportunityEvidence[]

  @@index([runId, promptVersionId])
  @@index([workspaceId, brandId, sampledAt])
}

model Mention {
  id            String      @id @default(uuid()) @db.Uuid
  workspaceId   String      @db.Uuid
  observationId String      @db.Uuid
  entityType    String // brand | competitor
  entityId      String      @db.Uuid
  kind          MentionKind
  rank          Int?
  confidence    Float
  excerpt       String?
  needsReview   Boolean     @default(false)
  createdAt     DateTime    @default(now()) @db.Timestamptz
  updatedAt     DateTime    @updatedAt @db.Timestamptz

  observation Observation @relation(fields: [observationId], references: [id], onDelete: Cascade)

  @@unique([observationId, entityId, kind])
  @@index([observationId, entityId])
}

model Citation {
  id            String              @id @default(uuid()) @db.Uuid
  workspaceId   String              @db.Uuid
  observationId String              @db.Uuid
  url           String
  canonicalUrl  String
  domain        String
  excerpt       String?
  association   CitationAssociation
  entityId      String?             @db.Uuid // own brand / competitor
  sourceType    String? // media | review | blog | directory | forum | industry | own | other
  verifiedAt    DateTime?           @db.Timestamptz
  createdAt     DateTime            @default(now()) @db.Timestamptz
  updatedAt     DateTime            @updatedAt @db.Timestamptz

  observation Observation @relation(fields: [observationId], references: [id], onDelete: Cascade)

  @@unique([observationId, canonicalUrl])
  @@index([workspaceId, domain])
}

model MetricSnapshot {
  id            String   @id @default(uuid()) @db.Uuid
  workspaceId   String   @db.Uuid
  brandId       String   @db.Uuid
  date          DateTime @db.Date
  cohortHash    String
  engine        String // "all" dahil
  surface       String
  formulaVersion String
  numerator     Json
  denominator   Json
  values        Json
  coverage      Float?
  sampleCount   Int
  createdAt     DateTime @default(now()) @db.Timestamptz
  updatedAt     DateTime @updatedAt @db.Timestamptz

