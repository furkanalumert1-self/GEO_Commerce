# Callypso AI Growth — ortam değişkenleri. Tüm değerler boş placeholder'dır; startup'ta Zod ile doğrulanır.
# NEXT_PUBLIC_* yalnız public değerler içindir. Gerçek sırlar yalnız sunucuda kalır.
# Kapalı bir özelliğin env'i zorunlu değildir; eksik anahtar arayüzde açık "not_configured" durumu olarak görünür.

# --- Uygulama ---
APP_URL=http://localhost:3000
DATABASE_URL=                      # postgresql://geo:geo@localhost:5432/geo
DB_POOL_MAX=                       # opsiyonel: fonksiyon örneği başına DB bağlantısı (Vercel varsayılanı 3, yerel 10)
REDIS_URL=                         # redis://localhost:6379 (yalnız JOB_EXECUTION_MODE=queue)
JOB_EXECUTION_MODE=queue           # queue: Redis + ayrı worker (npm run worker) | inline: Redis'siz geçici mod — işler açık sekmeden sınırlı adımlarla sunucuda yürür
AUTH_SECRET=                       # openssl rand -base64 32
AUTH_GOOGLE_ID=                    # opsiyonel: Google OAuth (callback: {APP_URL}/api/auth/callback/google)
AUTH_GOOGLE_SECRET=

# --- E-posta (smtp: Mailpit localde smtp://localhost:1025) ---
EMAIL_PROVIDER=smtp                # smtp | resend
SMTP_URL=
EMAIL_FROM=
RESEND_API_KEY=

# --- S3 uyumlu depolama (MinIO localde) ---
STORAGE_ENDPOINT=
STORAGE_REGION=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=

# --- Tenant entegrasyon sırlarının şifrelenmesi (AES-256-GCM, 32 byte base64) ---
SECRETS_KEY_ID=                    # ör. k1; anahtar rotasyonunda değişir
SECRETS_ENCRYPTION_KEY=

# --- Billing (Stripe; şirket ülkesinde kullanılabilirliği doğrulayın) ---
BILLING_PROVIDER=stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_GROWTH=
STRIPE_PRICE_COMMERCE=
STRIPE_PRICE_AGENCY=

# --- AI sağlayıcıları (model adları config'ten; "latest" sabiti yok) ---
OPENAI_API_KEY=
OPENAI_MONITOR_MODEL=
GENERATION_PROVIDER=openai
GENERATION_MODEL=
GOOGLE_AI_API_KEY=
GOOGLE_MONITOR_MODEL=
GOOGLE_MONITOR_FALLBACK_MODEL=     # isteğe bağlı: ana Gemini modeli bulunamaz/aşırı yüklüyse bir kez bununla denenir
ANTHROPIC_API_KEY=                 # Claude ölçümü (sunucu tarafı; istemciye/loga gitmez)
ANTHROPIC_MONITOR_MODEL=           # Anthropic model kimliği; boşsa Claude "kullanılamıyor"
PERPLEXITY_API_KEY=
PERPLEXITY_MONITOR_MODEL=
CRAWL_PROXY_TR=                    # isteğe bağlı: Türkiye çıkışlı HTTP(S) proxy (http://kullanici:sifre@host:port); ülkeye göre yönlendiren siteler için
LICENSED_MONITOR_BASE_URL=         # yalnız izinli/lisanslı UI takip kaynağı varsa
LICENSED_MONITOR_API_KEY=

# --- Commerce platform uygulama anahtarları (iç konfigürasyon adları; resmi auth şekline uyarlanır) ---
SHOPIFY_CLIENT_ID=                 # Shopify uygulaması; redirect URL: {APP_URL}/api/v1/integrations/shopify/callback
SHOPIFY_CLIENT_SECRET=             # OAuth + webhook imzası (yalnız sunucuda)
IKAS_APP_CLIENT_ID=
IKAS_APP_CLIENT_SECRET=
TICIMAX_APP_CLIENT_ID=
TICIMAX_APP_CLIENT_SECRET=
IDEASOFT_APP_CLIENT_ID=
IDEASOFT_APP_CLIENT_SECRET=

# --- Ads / tracker / operasyon ---
ADS_AUTOMATION_ENABLED=false
TRACKER_INGEST_ORIGIN=
PLATFORM_ADMIN_ALLOWLIST=          # virgülle ayrılmış e-posta listesi
SENTRY_DSN=
DAILY_PROVIDER_COST_CAP_USD=25
DEMO_MODE=false                    # true: yalnız isDemo workspace'lerde ve .example alan adlarında örnek veri; gerçek workspace'ler etkilenmez
DEMO_LOGIN=false                   # production build'de demo hesap butonlarını açar (yalnız @demo.example kullanıcıları, demo workspace'ler)
