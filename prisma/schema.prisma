// ───────────────────────────── Opportunities & actions ─────────────────────────────

model Opportunity {
  id             String            @id @default(uuid()) @db.Uuid
  workspaceId    String            @db.Uuid
  brandId        String            @db.Uuid
  clusterId      String            @db.Uuid
  gapType        GapType
  locale         String
  channel        String            @default("organic") // organic | paid
  title          String
  score          Int?
  provisional    Boolean           @default(false)
  components     Json
  confidence     Float
  status         OpportunityStatus @default(new)
  ownerId        String?           @db.Uuid
  priority       String            @default("medium")
  dueAt          DateTime?         @db.Timestamptz
  expectedEffort String?
  targetUrl      String?
  diagnosis      Json?
  recommendedAction String?
  paidBlockedReason String?
  dedupeKey      String
  createdAt      DateTime          @default(now()) @db.Timestamptz
  updatedAt      DateTime          @updatedAt @db.Timestamptz

  brand    Brand                 @relation(fields: [workspaceId, brandId], references: [workspaceId, id], onDelete: Cascade)
  cluster  IntentCluster         @relation(fields: [clusterId], references: [id], onDelete: Cascade)
  evidence OpportunityEvidence[]
  actions  Action[]

  @@unique([brandId, dedupeKey])
  @@index([workspaceId, brandId, status, score(sort: Desc)])
}

model OpportunityEvidence {
  id            String   @id @default(uuid()) @db.Uuid
  workspaceId   String   @db.Uuid
  opportunityId String   @db.Uuid
  observationId String?  @db.Uuid
  pageUrl       String?
  quote         String?
  note          String?
  createdAt     DateTime @default(now()) @db.Timestamptz
  updatedAt     DateTime @updatedAt @db.Timestamptz

  opportunity Opportunity  @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  observation Observation? @relation(fields: [observationId], references: [id], onDelete: SetNull)
}

model Action {
  id            String       @id @default(uuid()) @db.Uuid
  workspaceId   String       @db.Uuid
  brandId       String       @db.Uuid
  opportunityId String?      @db.Uuid
  type          ActionType
  status        ActionStatus @default(draft)
  title         String
  targetUrl     String?
  assigneeId    String?      @db.Uuid
  currentVersionId String?   @db.Uuid
  version       Int          @default(0) // optimistic concurrency
  publishedAt   DateTime?    @db.Timestamptz
  measurement   Json?
  createdAt     DateTime     @default(now()) @db.Timestamptz
  updatedAt     DateTime     @updatedAt @db.Timestamptz

  brand        Brand           @relation(fields: [workspaceId, brandId], references: [workspaceId, id], onDelete: Cascade)
  opportunity  Opportunity?    @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  versions     ActionVersion[]
  approvals    Approval[]
  publications Publication[]

  @@index([workspaceId, brandId, status])
}

model ActionVersion {
  id           String   @id @default(uuid()) @db.Uuid
  workspaceId  String   @db.Uuid
  actionId     String   @db.Uuid
  number       Int
  content      Json
  contentHash  String
  diff         Json?
  sourceHashes Json?
  createdById  String?  @db.Uuid
  generated    Boolean  @default(false)
  createdAt    DateTime @default(now()) @db.Timestamptz
  updatedAt    DateTime @updatedAt @db.Timestamptz

  action Action @relation(fields: [actionId], references: [id], onDelete: Cascade)

  @@unique([actionId, number])
}

model Approval {
  id          String    @id @default(uuid()) @db.Uuid
  workspaceId String    @db.Uuid
  actionId    String    @db.Uuid
  versionId   String    @db.Uuid
  versionHash String
  approverId  String    @db.Uuid
  revokedAt   DateTime? @db.Timestamptz
  createdAt   DateTime  @default(now()) @db.Timestamptz
  updatedAt   DateTime  @updatedAt @db.Timestamptz

  action Action @relation(fields: [actionId], references: [id], onDelete: Cascade)
}

model Publication {
  id            String    @id @default(uuid()) @db.Uuid
  workspaceId   String    @db.Uuid
  actionId      String    @db.Uuid
  integrationId String?   @db.Uuid
  resourceRef   String
  oldHash       String?
  newHash       String
  backupKey     String?
